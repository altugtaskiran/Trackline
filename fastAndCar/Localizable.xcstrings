    "Bir Sürüş Seç": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a Drive"
          }
        }
      }
    },
    "Bir crew oluştur ve arkadaşlarını davet et — sürüşlerinizi karşılaştırın, konum paylaşımı olmadan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a crew and invite your friends — compare your drives, no location sharing."
          }
        }
      }
    },
    "Bir sürüş bitirip paylaşırken bu crew ile paylaşmayı seçersen burada görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish a drive and choose to share it with this crew, and it'll show up here."
          }
        }
      }
    },
    "Bir sürüş detayında rotandan bir parkur oluştur, ya da yukarıdan ara.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a course from your route in a trip detail, or search above."
          }
        }
      }
    },
